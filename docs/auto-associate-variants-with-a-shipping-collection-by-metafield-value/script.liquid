{% assign collection_id = options.shipping_collection__picker_collection_required %}

{% capture query %}
  query {
    collection(id: {{ collection_id | json }}) {
      id
      sources {
        __typename
        id
        app { id }
        ... on CollectionConditionsSource {
          targetType
          shareable
          inclusion { conditions { __typename } }
          exclusion {
            conditions { __typename }
            selections(first: 1) { nodes { __typename } }
          }
        }
      }
    }
  }
{% endcapture %}

{% assign result = query | shopify %}

{% if event.preview %}
  {% capture result_json %}
    {
      "data": {
        "collection": {
          "id": {{ collection_id | json }},
          "sources": [{
            "__typename": "CollectionConditionsSource",
            "id": "gid://shopify/CollectionConditionsSource/1234567890",
            "app": null,
            "targetType": "VARIANTS",
            "shareable": false,
            "inclusion": {"conditions": []},
            "exclusion": null
          }]
        }
      }
    }
  {% endcapture %}
  {% assign result = result_json | parse_json %}
{% endif %}

{% assign collection = result.data.collection %}
{% assign source = collection.sources.first %}

{% unless collection.id == collection_id and collection.sources.size == 1 and source.__typename == "CollectionConditionsSource" %}
  {% error "Select a shipping collection with exactly one manual source. Collections with multiple sources or sub-collections aren't supported by this task." %}
  {% break %}
{% endunless %}

{% if source.app != nil or source.shareable != false or source.inclusion.conditions != empty or source.exclusion.conditions != blank or source.exclusion.selections.nodes != blank %}
  {% error "This task needs a manual collection source without conditions, exclusions, or an app owner. No collection changes were made." %}
  {% break %}
{% endif %}

{% unless source.targetType == "VARIANTS" %}
  {% error "Select a collection whose manual source targets variants. A product-level collection would also include nonmatching variants." %}
  {% break %}
{% endunless %}

{% assign metafield_namespace_and_key = options.metafield_namespace_and_key__required %}
{% assign metafield_value_to_match = options.metafield_value_to_match__required %}
{% assign variants = array %}
{% assign cursor = nil %}
{% assign pagination_complete = false %}

{% for n in (1..200) %}
  {% capture query %}
    query {
      {% if event.topic == "mechanic/user/trigger" %}
        productVariants(first: 250, after: {{ cursor | json }}) {
      {% else %}
        product(id: {{ product.admin_graphql_api_id | json }}) {
          variants(first: 250, after: {{ cursor | json }}) {
      {% endif %}
            nodes {
              id
              product { id }
              inventoryItem { requiresShipping }
              metafield(key: {{ metafield_namespace_and_key | json }}) { value }
            }
            pageInfo { hasNextPage endCursor }
          }
      {% unless event.topic == "mechanic/user/trigger" %}
        }
      {% endunless %}
    }
  {% endcapture %}
  {% assign result = query | shopify %}
  {% if event.topic == "mechanic/user/trigger" %}
    {% assign connection = result.data.productVariants %}
  {% else %}
    {% assign connection = result.data.product.variants %}
  {% endif %}

  {% if event.preview %}
    {% capture connection_json %}
      {
        "nodes": [{
          "id": "gid://shopify/ProductVariant/1234567890",
          "product": {"id": "gid://shopify/Product/1234567890"},
          "inventoryItem": {"requiresShipping": true},
          "metafield": {"value": {{ metafield_value_to_match | json }}}
        }],
        "pageInfo": {"hasNextPage": false, "endCursor": null}
      }
    {% endcapture %}
    {% assign connection = connection_json | parse_json %}
  {% endif %}

  {% unless connection.nodes and connection.pageInfo.hasNextPage != nil %}
    {% error "Unable to read all variants. No collection changes were made." %}
    {% break %}
  {% endunless %}
  {% assign variants = variants | concat: connection.nodes %}
  {% if connection.pageInfo.hasNextPage == false %}
    {% assign pagination_complete = true %}
    {% break %}
  {% elsif connection.pageInfo.endCursor == blank or connection.pageInfo.endCursor == cursor or forloop.last %}
    {% error "Unable to finish reading variants. No collection changes were made." %}
    {% break %}
  {% endif %}
  {% assign cursor = connection.pageInfo.endCursor %}
{% endfor %}

{% unless pagination_complete %}
  {% break %}
{% endunless %}

{% assign groups = variants | in_groups_of: 250, fill_with: false %}
{% for group in groups %}
  {% assign selections_to_add = array %}
  {% assign selections_to_remove = array %}
  {% assign product_ids = group | map: "product" | map: "id" | uniq %}
  {% for product_id in product_ids %}
    {% assign variant_ids_to_add = array %}
    {% assign variant_ids_to_remove = array %}
    {% for variant in group %}
      {% unless variant.product.id == product_id and variant.inventoryItem.requiresShipping %}
        {% continue %}
      {% endunless %}
      {% if variant.metafield.value == metafield_value_to_match %}
        {% assign variant_ids_to_add = variant_ids_to_add | push: variant.id %}
      {% else %}
        {% assign variant_ids_to_remove = variant_ids_to_remove | push: variant.id %}
      {% endif %}
    {% endfor %}
    {% if variant_ids_to_add != empty %}
      {% assign selection = hash %}
      {% assign selection["productId"] = product_id %}
      {% assign selection["variantIds"] = variant_ids_to_add %}
      {% assign selections_to_add = selections_to_add | push: selection %}
    {% endif %}
    {% if variant_ids_to_remove != empty %}
      {% assign selection = hash %}
      {% assign selection["productId"] = product_id %}
      {% assign selection["variantIds"] = variant_ids_to_remove %}
      {% assign selections_to_remove = selections_to_remove | push: selection %}
    {% endif %}
  {% endfor %}
{% if selections_to_add != empty or selections_to_remove != empty %}
  {% action "shopify" %}
    mutation {
      collectionUpdate(
        collection: {
          id: {{ collection_id | json }}
          sourcesToUpdate: [{
            condition: {
              id: {{ source.id | json }}
              inclusion: {
                selectionsToAdd: {{ selections_to_add | graphql_arguments }}
                selectionsToRemove: {{ selections_to_remove | graphql_arguments }}
              }
            }
          }]
        }
      ) {
        userErrors { field message }
      }
    }
  {% endaction %}
{% endif %}

{% endfor %}
