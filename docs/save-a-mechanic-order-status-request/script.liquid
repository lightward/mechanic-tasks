{% comment %}
Option order:
{{ options.webhook_event_topic__required }}
{{ options.form__orderstatusform_required }}
{{ options.initial_status__required }}
{{ options.initial_message__multiline }}
{% endcomment %}
{% if event.topic == "mechanic/actions/perform" %}
  {% if action.type == "shopify" %}
    {% if action.run.result.errors != blank %}{% error action.run.result.errors %}{% endif %}
    {% for result in action.run.result.data %}
      {% if result[1].userErrors != blank %}{% error result[1].userErrors %}{% endif %}
    {% endfor %}
  {% endif %}
  {% break %}
{% endif %}
{% assign form_id = options.form__orderstatusform_required %}
{% if event.preview and form_id == blank %}{% assign form_id = "dcdbe314-23fa-4afd-875b-9d52c6bd7110" %}{% endif %}
{% assign valid_form = form_id | match: '\A[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\z' %}
{% unless valid_form %}{% error "Choose a Thank you or Order status form in the task's Form option." %}{% break %}{% endunless %}
{% assign status_key = form_id | remove: "-" | prepend: "form_" %}
{% if event.topic == "mechanic/user/trigger" %}
  {% capture query %}query { metafieldDefinitions(first: 1, ownerType: ORDER, namespace: "mechanic_order_requests", key: {{ status_key | json }}) { nodes { id type { name } } } }{% endcapture %}
  {% assign result = query | shopify %}
  {% if result.errors != blank %}{% error result.errors %}{% break %}{% endif %}
  {% assign definition = result.data.metafieldDefinitions.nodes.first %}
  {% if definition %}
    {% if definition.type.name != "json" %}{% error "This order request metafield already has a different type. Resolve that definition before using this task." %}{% else %}{% log "The order request definition is ready." %}{% endif %}
  {% else %}
    {% action "shopify" %}mutation { metafieldDefinitionCreate(definition: { name: "Mechanic order request", namespace: "mechanic_order_requests", key: {{ status_key | json }}, type: "json", ownerType: ORDER, access: {storefront: NONE, customerAccount: NONE} }) { createdDefinition { id } userErrors { field message code } } }{% endaction %}
  {% endif %}
  {% break %}
{% endif %}
{% assign request = event.order_status_request %}
{% if event.preview %}
  {% capture preview %}{"version":1,"request_id":"a807b3c1-bbae-423d-99f8-8e6d5f0bdaf5","issued_at":{{ "now" | date: "%s" | plus: 0 }},"form":{"id":{{ form_id | json }},"title":"Order assistance","revision":1},"customer":{"id":"gid://shopify/Customer/1234567890"},"order":{"id":"gid://shopify/Order/1234567890","name":"#1001"},"fields":{"request_type":"Service request","details":"Could you help me with my order?"}}{% endcapture %}
  {% assign request = preview | parse_json %}
{% endif %}
{% unless request %}{% log "No verified order form submission was supplied. Nothing was changed or sent." %}{% break %}{% endunless %}
{% if request.form.id != form_id %}{% break %}{% endif %}
{% capture query %}query { order(id: {{ request.order.id | json }}) { id customer { id } metafield(namespace: "mechanic_order_requests", key: {{ status_key | json }}) { type jsonValue compareDigest } } }{% endcapture %}
{% assign result = query | shopify %}
{% if event.preview %}{% capture preview %}{"data":{"order":{"id":{{ request.order.id | json }},"customer":{"id":{{ request.customer.id | json }}},"metafield":null}}}{% endcapture %}{% assign result = preview | parse_json %}{% endif %}
{% if result.errors != blank %}{% error result.errors %}{% break %}{% endif %}
{% assign current_order = result.data.order %}
{% unless current_order.id and current_order.customer.id == request.customer.id %}{% error "This order is no longer accessible or belongs to a different customer. No request was saved." %}{% break %}{% endunless %}
{% assign metafield = current_order.metafield %}
{% if metafield and metafield.type != "json" %}{% error "The order request metafield must be JSON." %}{% break %}{% endif %}
{% assign previous = metafield.jsonValue %}
{% if previous and previous.form_id != form_id %}{% error "The saved request belongs to a different form. Nothing was overwritten." %}{% break %}{% endif %}
{% if previous.request_id == request.request_id %}{% log "This request was already saved; its current status was preserved." %}{% break %}{% endif %}
{% if previous.issued_at >= request.issued_at %}{% log "A request at least this recent is already saved. Nothing was overwritten." %}{% break %}{% endif %}
{% if previous %}
  {% assign repeat_requests = request.repeat_requests | default: "after_resolution" %}
  {% if repeat_requests == "never" %}{% log "This form allows one request per order. The saved request was preserved." %}{% break %}{% endif %}
  {% if repeat_requests != "always" and previous.status != "Resolved" and previous.status != "Declined" %}{% log "The previous request is still open. Resolve or decline it before accepting another." %}{% break %}{% endif %}
{% endif %}
{% assign initial_status = options.initial_status__required | strip %}
{% assign initial_message = options.initial_message__multiline | strip %}
{% if initial_status == blank or initial_status.size > 200 or initial_message.size > 2000 %}{% error "Use a status from 1–200 characters and a customer message up to 2000 characters." %}{% break %}{% endif %}
{% assign value = hash %}
{% assign value["form_id"] = form_id %}
{% assign value["request_id"] = request.request_id %}
{% assign value["customer_id"] = request.customer.id %}
{% assign value["placement"] = request.placement | default: "order_status" %}
{% assign value["verification"] = request.verification %}
{% assign value["issued_at"] = request.issued_at %}
{% assign value["fields"] = request.fields %}
{% assign value["line_items"] = request.line_items %}
{% assign value["status"] = initial_status %}
{% assign value["message"] = initial_message %}
{% assign value["updated_at"] = "now" | date: "%Y-%m-%dT%H:%M:%SZ" %}
{% assign order_id = request.order.id %}
{% assign value_json = value | json %}
{% assign encoded_size = value_json | base64 | size %}
{% if encoded_size > 120000 %}{% error "The order request is too large to store." %}{% break %}{% endif %}
{% action "shopify" %}mutation { metafieldsSet(metafields: [{ownerId: {{ order_id | json }}, namespace: "mechanic_order_requests", key: {{ status_key | json }}, type: "json", value: {{ value_json | json }}, compareDigest: {{ metafield.compareDigest | json }} }]) { metafields { id } userErrors { field message code } } }{% endaction %}
