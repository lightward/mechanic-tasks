{% comment %}
  {{ options.webhook_event_topic__required }}
  {{ options.form_id }}
  {{ options.form_name }}
{% endcomment %}
{% if event.topic != "mechanic/user/trigger" and event.topic != options.webhook_event_topic__required %}{% break %}{% endif %}
{% unless event.topic == "mechanic/user/trigger" %}
{% assign payload = event.data %}
{% if payload.body != nil %}{% assign payload = payload.body %}{% endif %}
{% if event.preview %}
  {% capture sample %}
    {"form":{"id":{{ options.form_id | default: "11111111-1111-4111-8111-111111111111" | json }},"revision":"1"},"submission_id":"22222222-2222-4222-8222-222222222222","fields":{"name":"Pat Example","email":"pat@example.com","product":"Garden lamp","issue":"The switch stopped working.","agree":"false","receipt":{"name":"receipt.txt","mime_type":"text/plain","size":4,"content_base64":"dGVzdA=="}}}
  {% endcapture %}
  {% assign payload = sample | parse_json %}
{% endif %}
{% assign form_keys = payload.form | keys %}
{% assign field_keys = payload.fields | keys %}
{% unless form_keys and field_keys %}
  {% error "This event is not a form submission. Expected form and fields objects in the webhook body." %}
  {% break %}
{% endunless %}
{% assign form_id_type = payload.form.id | json | slice: 0, 1 %}
{% assign submission_id_type = payload.submission_id | json | slice: 0, 1 %}
{% unless form_id_type == '"' and submission_id_type == '"' %}
  {% error "The form and submission IDs must be strings." %}{% break %}
{% endunless %}
{% assign valid_form_id = payload.form.id | match: '\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z' %}
{% assign valid_submission_id = payload.submission_id | match: '\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z' %}
{% unless valid_form_id and valid_submission_id %}
  {% error "The form or submission ID is invalid." %}{% break %}
{% endunless %}
{% if options.form_id != blank and options.form_id != payload.form.id %}
  {% log "This submission belongs to another form; nothing was saved." %}{% break %}
{% endif %}
{% assign revision = payload.form.revision | append: "" %}
{% assign valid_revision = revision | match: '\A[1-9][0-9]{0,9}\z' %}
{% unless valid_revision %}
  {% error "The form revision is missing or invalid." %}{% break %}
{% endunless %}
{% if field_keys.size > 50 %}
  {% error "A form submission may have at most 50 fields." %}{% break %}
{% endif %}
{% assign event_id = event.id | append: "" %}
{% assign received_at = event.created_at | date: "%Y-%m-%dT%H:%M:%S%:z" %}
{% if event.preview %}
  {% assign event_id = "33333333-3333-4333-8333-333333333333" %}
  {% assign received_at = "2026-09-14T12:00:00+00:00" %}
{% endif %}
{% if event_id == blank or received_at == blank %}
  {% error "The Mechanic event ID and creation time are required." %}{% break %}
{% endif %}
{% assign answers = hash %}
{% assign attachments = hash %}
{% assign invalid_field = false %}
{% assign address_keys = "line1,line2,city,region,postal_code,country" | split: "," %}
{% for field in payload.fields %}
  {% assign key = field[0] %}
  {% assign value = field[1] %}
  {% assign key_valid = key | match: '\A[a-z][a-z0-9_]{0,63}\z' %}
  {% unless key_valid %}{% assign invalid_field = true %}{% break %}{% endunless %}
  {% assign value_type = value | json | slice: 0, 1 %}
  {% if value_type == '"' %}
    {% if value.size > 4000 %}{% assign invalid_field = true %}{% break %}{% endif %}
    {% assign answers[key] = value %}
  {% elsif value_type == "[" %}
    {% if value.size > 50 %}{% assign invalid_field = true %}{% break %}{% endif %}
    {% for item in value %}
      {% assign item_type = item | json | slice: 0, 1 %}
      {% if item_type != '"' or item.size > 4000 %}{% assign invalid_field = true %}{% break %}{% endif %}
    {% endfor %}
    {% assign answers[key] = value %}
  {% elsif value_type == "{" %}
    {% if value.content_base64 != nil %}
      {% assign name_type = value.name | json | slice: 0, 1 %}
      {% assign mime_type = value.mime_type | json | slice: 0, 1 %}
      {% assign content_type = value.content_base64 | json | slice: 0, 1 %}
      {% assign size_json = value.size | json %}
      {% assign size_valid = size_json | match: '\A[0-9]+\z' %}
      {% if name_type != '"' or mime_type != '"' or content_type != '"' or size_valid == nil or value.size > 4194304 or value.name.size > 255 or value.mime_type.size > 255 %}
        {% assign invalid_field = true %}{% break %}
      {% endif %}
      {% assign file = hash %}
      {% assign file["name"] = value.name %}
      {% assign file["mime_type"] = value.mime_type %}
      {% assign file["size"] = value.size %}
      {% assign file["contents_saved"] = false %}
      {% assign attachments[key] = file %}
    {% else %}
      {% for part in value %}
        {% assign part_type = part[1] | json | slice: 0, 1 %}
        {% unless address_keys contains part[0] %}{% assign invalid_field = true %}{% break %}{% endunless %}
        {% if part_type != '"' or part[1].size > 200 %}{% assign invalid_field = true %}{% break %}{% endif %}
      {% endfor %}
      {% assign answers[key] = value %}
    {% endif %}
  {% else %}
    {% assign invalid_field = true %}
  {% endif %}
  {% if invalid_field %}{% break %}{% endif %}
{% endfor %}
{% if invalid_field %}
  {% error "A field has an unsupported value or exceeds the form limits. No submission data was saved." %}{% break %}
{% endif %}
{% assign answers_json = answers | json %}
{% assign attachments_json = attachments | json %}
{% assign encoded_size = answers_json | append: attachments_json | base64 | size %}
{% if encoded_size > 133332 %}
  {% error "The answers and file details exceed this task's 100 KB storage limit. Nothing was saved." %}{% break %}
{% endif %}
{% endunless %}
{% capture query %}
  query {
    metaobjectDefinitionByType(type: "mechanic_form_submission") {
      id
      access { storefront }
      fieldDefinitions { key type { name } required }
    }
  }
{% endcapture %}
{% assign result = query | shopify %}
{% if event.preview %}
  {% capture fixture %}
    {"data":{"metaobjectDefinitionByType":{% if event.topic == "mechanic/user/trigger" %}null{% else %}{"id":"gid://shopify/MetaobjectDefinition/1","access":{"storefront":"NONE"},"fieldDefinitions":[{"key": "title", "type": {"name": "single_line_text_field"}, "required": false}, {"key": "form_id", "type": {"name": "single_line_text_field"}, "required": false}, {"key": "form_revision", "type": {"name": "single_line_text_field"}, "required": false}, {"key": "submission_id", "type": {"name": "single_line_text_field"}, "required": false}, {"key": "event_id", "type": {"name": "single_line_text_field"}, "required": false}, {"key": "received_at", "type": {"name": "date_time"}, "required": false}, {"key": "answers", "type": {"name": "json"}, "required": false}, {"key": "attachments", "type": {"name": "json"}, "required": false}]}{% endif %}}}
  {% endcapture %}
  {% assign result = fixture | parse_json %}
{% endif %}
{% if result.errors != blank or result.data == nil %}
  {% error "The metaobject definition could not be checked. Nothing was saved." %}{% break %}
{% endif %}
{% assign definition = result.data.metaobjectDefinitionByType %}
{% capture expected_json %}{"title": "single_line_text_field", "form_id": "single_line_text_field", "form_revision": "single_line_text_field", "submission_id": "single_line_text_field", "event_id": "single_line_text_field", "received_at": "date_time", "answers": "json", "attachments": "json"}{% endcapture %}
{% assign expected = expected_json | parse_json %}
{% if definition %}
  {% if definition.access.storefront != "NONE" %}
    {% error "This submission definition has storefront access. Turn off storefront access before saving customer submissions." %}{% break %}
  {% endif %}
  {% assign compatible = true %}
  {% for expected_field in expected %}
    {% assign actual = definition.fieldDefinitions | where: "key", expected_field[0] | first %}
    {% if actual.type.name != expected_field[1] %}{% assign compatible = false %}{% endif %}
  {% endfor %}
  {% for actual in definition.fieldDefinitions %}
    {% if actual.required and expected[actual.key] == nil %}{% assign compatible = false %}{% endif %}
  {% endfor %}
  {% unless compatible %}
    {% error "The mechanic_form_submission definition has incompatible fields. Review its fields before running this task; the task does not change existing definitions." %}{% break %}
  {% endunless %}
{% endif %}
{% if event.topic == "mechanic/user/trigger" %}
  {% if definition %}
    {% log "The Mechanic form submission definition is ready. No changes were needed." %}
  {% else %}
    {% action "shopify" %}
      {"query":"mutation SetupFormSubmissions($definition: MetaobjectDefinitionCreateInput!) { metaobjectDefinitionCreate(definition: $definition) { metaobjectDefinition { id } userErrors { field message } } }","variables":{"definition":{"name": "Mechanic form submission", "type": "mechanic_form_submission", "displayNameKey": "title", "access": {"storefront": "NONE"}, "fieldDefinitions": [{"key": "title", "name": "Submission", "type": "single_line_text_field"}, {"key": "form_id", "name": "Form code", "type": "single_line_text_field"}, {"key": "form_revision", "name": "Form revision", "type": "single_line_text_field"}, {"key": "submission_id", "name": "Submission ID", "type": "single_line_text_field"}, {"key": "event_id", "name": "Mechanic event ID", "type": "single_line_text_field"}, {"key": "received_at", "name": "Received at", "type": "date_time"}, {"key": "answers", "name": "Answers", "type": "json"}, {"key": "attachments", "name": "File details (contents not saved)", "type": "json"}]}}}
    {% endaction %}
  {% endif %}
  {% break %}
{% endif %}
{% unless definition %}
  {% error "Run this task manually once to create the Mechanic form submission definition before collecting submissions." %}{% break %}
{% endunless %}
{% comment %}Use the trusted Mechanic event ID, never a visitor-controlled ID, to select the stored record.{% endcomment %}
{% assign handle = event_id | sha256 | prepend: "event-" %}
{% assign title = options.form_name | default: payload.form.id | append: " — " | append: received_at %}
{% action "shopify" %}
  {"query":"mutation SaveFormSubmission($handle: MetaobjectHandleInput!, $metaobject: MetaobjectUpsertInput!) { metaobjectUpsert(handle: $handle, metaobject: $metaobject) { metaobject { id handle } userErrors { field message } } }",
   "variables":{"handle":{"type":"mechanic_form_submission","handle":{{ handle | json }}},"metaobject":{"fields":[
     {"key":"title","value":{{ title | json }}},
     {"key":"form_id","value":{{ payload.form.id | json }}},
     {"key":"form_revision","value":{{ revision | json }}},
     {"key":"submission_id","value":{{ payload.submission_id | json }}},
     {"key":"event_id","value":{{ event_id | json }}},
     {"key":"received_at","value":{{ received_at | json }}},
     {"key":"answers","value":{{ answers_json | json }}},
     {"key":"attachments","value":{{ attachments_json | json }}}
   ]}}}
{% endaction %}
