{% comment %}
  Option order:

  {{ options.email_subject__required }}
  {{ options.email_body__required_multiline }}
  {{ options.reply_to_email_address__email }}
  {{ options.from_display_name }}
  {{ options.bcc_email_addresses__email_array }}
  {{ options.test_mode__boolean }}
{% endcomment %}

{% if event.topic == "mechanic/actions/perform" %}
  {% if event.preview %}
    {% assign action = event.data %}
  {% endif %}

  {% if action.type == "shopify" and action.meta.stage == "claim_order" %}
    {% unless action.run.ok and action.run.result.data.metafieldsSet.metafields.first.id %}
      {% log "The order was not claimed. No email was queued. Check the Shopify action for details." %}
      {% break %}
    {% endunless %}

    {% assign meta = hash %}
    {% assign meta["stage"] = "send_email" %}
    {% assign meta["order_id"] = action.meta.order_id %}
    {% action "email", __meta: meta %}
      {{ action.meta.email_options | json }}
    {% endaction %}

  {% elsif action.type == "email" and action.meta.stage == "send_email" %}
    {% unless action.run.ok %}
      {% log "The email action did not succeed. The order has not been tagged." %}
      {% break %}
    {% endunless %}

    {% action "shopify", __perform_event: false %}
      mutation {
        tagsAdd(id: {{ action.meta.order_id | json }}, tags: ["customer-emailed"]) {
          node { id }
          userErrors { field message }
        }
      }
    {% endaction %}
  {% endif %}

  {% break %}
{% endif %}

{% assign reply_to = options.reply_to_email_address__email | default: shop.customer_email %}
{% assign from_display_name = options.from_display_name | default: shop.name %}
{% assign bcc = options.bcc_email_addresses__email_array %}
{% assign test_mode = options.test_mode__boolean %}

{% assign flow_data = event.data %}

{% if event.preview and flow_data == blank %}
  {% assign flow_data = hash %}
  {% assign flow_data["order_id"] = "gid://shopify/Order/1234567890" %}
{% endif %}

{% comment %}
  -- Flow sends the order ID as event data; it may be a full GID or a plain numeric ID
{% endcomment %}

{% assign flow_data_keys = flow_data | keys %}
{% assign order_id_match = nil %}
{% assign data_problem = nil %}

{% if flow_data == nil %}
  {% assign data_problem = "Shopify Flow sent this event without any event data." %}

{% elsif flow_data_keys == nil %}
  {% assign data_problem = "The event data that Shopify Flow sent is not a JSON object." %}

{% elsif flow_data_keys contains "__error" %}
  {% assign data_problem = "The event data that Shopify Flow sent is not valid JSON." %}

{% else %}
  {% assign order_id_match = flow_data["order_id"] | append: "" | strip | match: "\A(gid://shopify/Order/)?([0-9]+)\z" %}

  {% if order_id_match == nil %}
    {% assign data_problem = "The event data that Shopify Flow sent does not include a usable order_id." %}
  {% endif %}
{% endif %}

{% if data_problem != nil %}
  {% capture error_message %}{{ data_problem }} No email was sent. Check the "Send event to Mechanic" step in your Shopify Flow workflow. Its event data should be {% raw %}{"order_id": "{{order.id}}"}{% endraw %}{% endcapture %}

  {% error error_message %}

{% else %}
  {% assign order_gid = order_id_match.captures.last | prepend: "gid://shopify/Order/" %}

  {% capture query %}
    query {
      order(id: {{ order_gid | json }}) {
        id
        name
        email
        displayFulfillmentStatus
        displayFinancialStatus
        statusPageUrl
        tags
        emailClaim: metafield(namespace: "mechanic", key: "flow_customer_email_claim") { id }
        customer {
          firstName
          lastName
          defaultEmailAddress {
            emailAddress
          }
        }
        displayAddress {
          firstName
          lastName
        }
      }
    }
  {% endcapture %}

  {% assign result = query | shopify %}

  {% if event.preview %}
    {% capture result_json %}
      {
        "data": {
          "order": {
            "id": {{ order_gid | json }},
            "name": "#1234",
            "email": "customer@example.com",
            "displayFulfillmentStatus": "UNFULFILLED",
            "displayFinancialStatus": "PAID",
            "statusPageUrl": "https://example.myshopify.com/12345678/orders/0a1b2c3d4e5f6a7b8c9d/authenticate?key=0a1b2c3d4e5f6a7b8c9d",
            "customer": {
              "firstName": "Jordan",
              "lastName": "Lee",
              "defaultEmailAddress": {
                "emailAddress": "customer@example.com"
              }
            },
            "displayAddress": {
              "firstName": "Jordan",
              "lastName": "Lee"
            }
          }
        }
      }
    {% endcapture %}

    {% assign result = result_json | parse_json %}
  {% endif %}

  {% assign order = result.data.order %}
  {% assign recipient = order.email | default: order.customer.defaultEmailAddress.emailAddress %}

  {% if order == nil %}
    {% log message: "Shopify did not return an order for this ID, so no email was sent.", order_id: order_gid %}

  {% elsif order.tags contains "customer-emailed" or order.emailClaim %}
    {% log message: "This order has already been claimed or emailed. Skipping the request.", order: order.name %}

  {% elsif recipient == blank %}
    {% log message: "This order has no email address, and neither does its customer, so no email was sent.", order: order.name %}

  {% else %}
    {% comment %}
      -- fill in the placeholders, using a fallback wherever a value is missing
    {% endcomment %}

    {% assign customer_first_name = order.customer.firstName | default: order.displayAddress.firstName | default: "there" %}
    {% assign customer_last_name = order.customer.lastName | default: order.displayAddress.lastName | default: "" %}

    {% assign email_subject = options.email_subject__required
      | replace: "ORDER_NAME", order.name
      | replace: "ORDER_STATUS_URL", order.statusPageUrl
      | replace: "SHOP_NAME", shop.name
      | replace: "CUSTOMER_FIRST_NAME", customer_first_name
      | replace: "CUSTOMER_LAST_NAME", customer_last_name
      | strip %}

    {% comment %}
      -- the body is sent as HTML, so the values going into it are escaped first
    {% endcomment %}

    {% assign order_name_html = order.name | escape %}
    {% assign order_status_url_html = order.statusPageUrl | escape %}
    {% assign shop_name_html = shop.name | escape %}
    {% assign customer_first_name_html = customer_first_name | escape %}
    {% assign customer_last_name_html = customer_last_name | escape %}

    {% assign email_body = options.email_body__required_multiline
      | replace: "ORDER_NAME", order_name_html
      | replace: "ORDER_STATUS_URL", order_status_url_html
      | replace: "SHOP_NAME", shop_name_html
      | replace: "CUSTOMER_FIRST_NAME", customer_first_name_html
      | replace: "CUSTOMER_LAST_NAME", customer_last_name_html
      | strip
      | newline_to_br %}

    {% log
      message: "Order found, and its email is ready.",
      order: order.name,
      fulfillment_status: order.displayFulfillmentStatus,
      financial_status: order.displayFinancialStatus,
      test_mode: test_mode
    %}

    {% if test_mode and event.preview != true %}
      {% action "echo"
        test_mode: "Test mode is on, so this email was not sent.",
        to: recipient,
        subject: email_subject,
        body: email_body,
        reply_to: reply_to,
        from_display_name: from_display_name,
        bcc: bcc
      %}

    {% else %}
      {% assign email_options = hash %}
      {% assign email_options["to"] = recipient %}
      {% assign email_options["subject"] = email_subject | strip %}
      {% assign email_options["body"] = email_body | strip | newline_to_br %}
      {% assign email_options["reply_to"] = reply_to %}
      {% assign email_options["from_display_name"] = from_display_name %}
      {% assign email_options["bcc"] = bcc %}

      {% assign meta = hash %}
      {% assign meta["stage"] = "claim_order" %}
      {% assign meta["order_id"] = order_gid %}
      {% assign meta["email_options"] = email_options %}
      {% comment %}Only the first request can create this metafield, even if two tag edits arrive together.{% endcomment %}
      {% action "shopify", __meta: meta %}
        mutation {
          metafieldsSet(metafields: [{
            ownerId: {{ order_gid | json }}, namespace: "mechanic", key: "flow_customer_email_claim",
            type: "single_line_text_field", value: {{ event.id | append: "" | json }}, compareDigest: null
          }]) {
            metafields { id }
            userErrors { field message code }
          }
        }
      {% endaction %}
    {% endif %}
  {% endif %}
{% endif %}
