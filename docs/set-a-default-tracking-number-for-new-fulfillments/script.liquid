{% if event.preview or fulfillment.tracking_number == blank %}
  {% action "shopify" %}
    mutation {
      fulfillmentTrackingInfoUpdate(
        fulfillmentId: {{ fulfillment.admin_graphql_api_id | json }}
        trackingInfoInput: {
          number: {{ options.default_tracking_number__required | json }}
        }
        notifyCustomer: {{ options.notify_customer__boolean | json }}
      ) {
        fulfillment {
          id
          trackingInfo {
            number
            url
          }
        }
        userErrors {
          field
          message
        }
      }
    }
  {% endaction %}
{% endif %}
